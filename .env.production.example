# Copy to .env.production; chmod 600. Never commit the filled file.
# Use this file for interpolation too: docker compose --env-file .env.production -f compose.production.yml ...
APP_DOMAIN=kastjes.example.nl
# Unique release tag; never reuse a tag for different code.
APP_VERSION=release-2026-10-01-1
# Fill with the existing/bootstrapped workspace UUID if more than one exists.
PUBLIC_WORKSPACE_ID=
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_COUNT=14
WORKER_POLL_MS=5000
WORKER_JOB_LEASE_MS=300000
SESSION_TTL_HOURS=24
RATE_LIMIT_PER_MINUTE=120
# Optional Google Maps overlay; paid Google billing requires the account owner's decision.
# Restrict browser key to https://<APP_DOMAIN>/* and Maps JavaScript API; then rebuild.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
# Paths INSIDE the container's durable /app/data volume. Never use host paths here.
NEXTDOOR_APPROVED_EXPORT_PATH=
BUURTKASTJESKAART_EXPORT_PATH=
FACEBOOK_GRAPH_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_VERSION=
FACEBOOK_PAGE_CONTEXTS_JSON=[]
OSM_OVERPASS_URL=
OSM_PILOT_BBOX=
HAI_FEED_TOKEN=
HAI_WORKSPACE_ID=
HAI_PROJECT_KEY=015-Weggeefkastje
