{
  "name": "weggeefkastje-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.22.1 || ^26.12.1",
    "npm": "12.2.1"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server-main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "ingest": "tsx src/worker.ts --once",
    "ingest:legacy": "tsx src/index.ts",
    "serve": "tsx src/server-main.ts",
    "start": "node dist/server-main.js",
    "start:worker": "node dist/worker.js",
    "start:backup": "node dist/backup-worker.js",
    "smoke:production": "node scripts/production-smoke.mjs",
    "worker": "tsx src/worker.ts",
    "cli": "tsx src/cli.ts",
    "migrate": "tsx src/cli.ts migrate",
    "doctor": "tsx src/cli.ts doctor",
    "backup": "tsx src/cli.ts backup",
    "benchmark": "tsx src/benchmark.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "node scripts/lint.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "smoke": "vitest run --config vitest.config.ts tests/critical-path.test.ts",
    "windows:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows.ps1",
    "windows:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-windows.ps1",
    "windows:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-windows.ps1",
    "build:sqlite": "node scripts/build-stable-sqlite.mjs",
    "lint:install": "npm --prefix tools/lint ci"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "cheerio": "1.2.0",
    "compression": "1.8.2",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/google.maps": "3.66.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "concurrently": "10.0.6",
    "jsdom": "30.1.3",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "node-gyp": "13.1.0"
  },
  "packageManager": "npm@12.2.1"
}
